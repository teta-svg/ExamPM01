<Window x:Class="CafeExam.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CafeExam"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Введите количество блюд" Grid.Column="0" Grid.Row="0"/>
        <TextBox Name="CourseCount" Grid.Row="0" Grid.Column="1"/>
        <Button Name="SubmitButton" Content="Подтвердить" Grid.Row="0" Grid.Column="2" Click="SubmitButton_Click"/>

        <TextBlock Text="Введите название блюда" Grid.Column="0" Grid.Row="1"/>
        <TextBlock Text="Введите цену блюда" Grid.Column="1" Grid.Row="1"/>
        <TextBlock Text="Введите время приготовления (в минутах)" Grid.Column="2" Grid.Row="1"/>

        <TextBox Name="NameBox" Grid.Row="2" Grid.Column="0"/>
        <TextBox Name="PriceBox" Grid.Row="2" Grid.Column="1"/>
        <TextBox Name="DurationBox" Grid.Row="2" Grid.Column="2"/>

        <Button Name="AddCourseButton" Content="Добавить блюдо" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Click="AddCourseButton_Click"/>

        <TextBlock Text="Исходный массив" Grid.Column="0" Grid.Row="4"/>
        <TextBlock Text="Отсортированный массив" Grid.Column="2" Grid.Row="4"/>

        <Grid Grid.ColumnSpan="3" Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Column="0" Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Название блюда" Grid.Column="0"/>
                <TextBlock Text="Цена" Grid.Column="1" HorizontalAlignment="Center"/>
                <TextBlock Text="Время" Grid.Column="2" HorizontalAlignment="Center"/>
            </Grid>

            <Grid Grid.Column="1" Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Название блюда" Grid.Column="0"/>
                <TextBlock Text="Цена" Grid.Column="1" HorizontalAlignment="Center"/>
                <TextBlock Text="Время" Grid.Column="2" HorizontalAlignment="Center"/>
            </Grid>

            <ListBox Name="SourceArr" ItemsSource="{Binding SourseCourses}" Grid.Column="0" Grid.Row="1" HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Name}" Grid.Column="0"/>
                            <TextBlock Text="{Binding Price}" Grid.Column="1" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding Duration}" Grid.Column="2" HorizontalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <ListBox Name="SortedArr" ItemsSource="{Binding SortedCourses}" Grid.Column="1" Grid.Row="1" HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Name}" Grid.Column="0"/>
                            <TextBlock Text="{Binding Price}" Grid.Column="1" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding Duration}" Grid.Column="2" HorizontalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

        </Grid>

        <Button Name="SortButton" Content="Сортировать список" Grid.ColumnSpan="3" Grid.Row="6" Click="SortButton_Click"/>
    </Grid>
</Window>